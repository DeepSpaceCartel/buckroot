The emulator and file-manager packages of the FunKey external tree pack an OPK with $(HOST_DIR)/usr/bin/mksquashfs in their
target-install step without depending on host-squashfs. With a global host directory the tool happens to be there from another
package; with per-package directories (BR2_PER_PACKAGE_DIRECTORIES, which buckroot requires) the package's own host directory lacks it and
the install fails with "mksquashfs: No such file or directory". Declaring the dependency is what Buildroot's documentation for per-package
directories asks for; it changes nothing in the image. (PCSX-ReARMed is fixed by patch 0001.)

--- a/package/PocketSNES/PocketSNES.mk
+++ b/package/PocketSNES/PocketSNES.mk
@@ -10,7 +10,7 @@
 POCKETSNES_LICENSE = GPL-2.0
 POCKETSNES_LICENSE_FILES = COPYING
 
-POCKETSNES_DEPENDENCIES = sdl sdl_image sdl_mixer sdl_ttf zlib
+POCKETSNES_DEPENDENCIES = sdl sdl_image sdl_mixer sdl_ttf zlib host-squashfs
 
 POCKETSNES_CFLAGS = $(TARGET_CFLAGS) $(subst $\",,$(BR2_TARGET_OPTIMIZATION)) -mfloat-abi=hard -ffast-math -funsafe-math-optimizations
 
