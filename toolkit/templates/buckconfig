# Generated by `br2 sync` from the toolkit template + project.json. Do not edit; put project
# settings in project.json and per-run settings on the command line (`br2 build --mode ...`).
[cells]
  root = .
  prelude = prelude
  toolchains = toolchains
  none = none

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  fbcode_macros = none
  buck = none

# Uses the prelude bundled with the pinned buck2 binary (see scripts/fetch-buck2.sh).
[external_cells]
  prelude = bundled

[parser]
  target_platform_detector_spec = target:root//...->root//platforms:default \
    target:prelude//...->root//platforms:default \
    target:toolchains//...->root//platforms:default

[build]
  execution_platforms = root//platforms:default

# Keep the file watcher off huge or irrelevant trees: Buildroot's build output and
# download cache, nested git metadata, our own scratch/tool directories.
[project]
  ignore = .git, buildroot-src/.git, buildroot-src/output, buildroot-src/dl, out, tools

# All switches default to a plain local build; `br2 build --mode ...` overrides them.
#   remote_cache / cache_uploads   look up / upload results in the Buildbarn cache
#   remote_execution / local_execution   run actions on the Buildbarn worker (never locally)
#   native / native_project        packages built by Buck2 actions instead of `make <pkg>`
#                                  (native_project: those living in this project's native/)
#   external                       does the project have a BR2_EXTERNAL tree
[br2]
  remote_cache = false
  cache_uploads = false
  remote_execution = false
  local_execution = true
  external = @EXTERNAL@
  rootfs_image = @ROOTFS_IMAGE@
  fragment = @FRAGMENT@
  native =
  native_project = @NATIVE_PROJECT@

[buck2_re_client]
  engine_address = grpc://localhost:8980
  action_cache_address = grpc://localhost:8980
  cas_address = grpc://localhost:8980
  tls = false
  instance_name = @NAME@
