export_file(
    name = "slicing.py",
    visibility = ["PUBLIC"],
)

export_file(
    name = "native_pkg.py",
    visibility = ["PUBLIC"],
)

export_file(
    name = "native_config.py",
    visibility = ["PUBLIC"],
)
