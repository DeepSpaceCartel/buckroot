# Hand-written build-system layer: the rules live in rules.bzl, the action driver is
# exported so rules can take it as an (implicit) input.
export_file(
    name = "pkg_action.py",
    visibility = ["PUBLIC"],
)

# Config slicing lives in its own script so that editing it does not invalidate the
