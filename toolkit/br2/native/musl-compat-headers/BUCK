# musl-compat-headers (package/musl-compat-headers): two BSD headers musl lacks, installed into
# the toolchain sysroot ($(STAGING_DIR)/usr/include/sys/), mode 0644.
load("//br2:rules.bzl", "br2_dep", "BR2_STAMPS_STAGING", "br2_native_package")

br2_native_package(
    name = "musl-compat-headers",
    pkg = "musl-compat-headers",
    bdir = "buildroot-src/package/musl-compat-headers",
    pkg_inputs = "//buildroot-src/package/musl-compat-headers:inputs",
    stamp_dir = "build/musl-compat-headers",
    stamps = BR2_STAMPS_STAGING,
    staging_install = {
        "usr/include/sys/queue.h": "//buildroot-src/package/musl-compat-headers:queue.h",
        "usr/include/sys/cdefs.h": "//buildroot-src/package/musl-compat-headers:file.cdefs.h",
    },
    deps = [
        br2_dep("host-fakedate", "//buildroot-src/package/fakedate:host-fakedate"),
        br2_dep("host-skeleton", "//buildroot-src/package/skeleton:host-skeleton"),
        br2_dep("skeleton", "//buildroot-src/package/skeleton:skeleton"),
    ],
    visibility = ["PUBLIC"],
)
