#!/usr/bin/env python3
"""br2: drive the Buck2 instrumentation of a Buildroot project. Run from an experiment directory
(one that has a project.json; see scripts/br2project.py).

  br2 setup [--no-buck2]             install buck2, fetch the Buildroot tree named in project.json
  br2 extract                        defconfig -> golden/model.json, then render the BUCK files
  br2 fetch                          download sources Buck2's http_file cannot express, vendor them
  br2 preflight                      extract+patch every package in its view, compare with golden (minutes)
  br2 golden [--vanilla] [--k8s]     plain `make` build with the instrumentation's config fragment
                                     (what Buck2 must reproduce) -> golden/rootfs.manifest.json + timing;
                                     --vanilla: the project's defconfig untouched, for reference
  br2 dev [--pkg P]                  iteration loop: no clean, --keep-going, one summary of every failure,
                                     toolkit edits do not invalidate cached results (dev only, no numbers)
  br2 viewcheck [--mode M]           prove every package's view entries are declared inputs (M=remote: on the worker)
  br2 build --variant V --mode M     one Buck2 build of //:rootfs, timed, checked against golden
  br2 matrix [--variants ..] [--modes ..]   every variant x mode, results/matrix.{json,md}

variants: wrapped  every package runs Buildroot's own `make <pkg>` inside a Buck2 action
          native   the packages listed in project.json "native" are built by Buck2 actions
modes:    local          Buck2 executes locally, no remote cache
          local-cache    local execution, results uploaded to / served from the Buildbarn cache
          remote         actions execute on the Buildbarn worker, no cache (fresh instance name)
          remote-cache   actions execute on the worker, results cached (warm instance name)
The two cache modes run twice: cold (populates the cache) and warm (after `buck2 clean`).
"""
import argparse
import concurrent.futures
import json
import os
import re
import subprocess
import sys
import threading
import time
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
import br2project  # noqa: E402

CFG = br2project.load(Path(__file__).resolve().parent)
ROOT = CFG["root"]
BUCK2 = str(ROOT / "tools" / "buck2")
CACHE = br2project.cache_dir(CFG)
MODES = ["local", "local-cache", "remote", "remote-cache"]
VARIANTS = ["wrapped", "native"]
TARGET = "//:rootfs"
# project.json "baseline": the tool-baseline image tag the project's era needs (e.g. "ubuntu20.04" for a Buildroot <= 2021 pin;
# see toolkit/infra/buildbarn/runner/Dockerfile). Its remote actions then go to the "legacy" pool, whose workers run that image, and
# its golden Job uses the same image, so golden and Buck2 builds share one baseline.
BASELINE = CFG.get("baseline", "")
POOL = "legacy" if BASELINE else ""      # --pool overrides: which Buildbarn worker pool (scheduler) the actions go to; see instance()
RE_ENDPOINT = os.environ.get("BR2_RE_ENDPOINT", "")   # grpc://host:port of the cache/execution endpoint, when not localhost:8980


def sh(cmd, **kw):
    print("+ " + " ".join(str(c) for c in cmd), flush=True)
    return subprocess.run([str(c) for c in cmd], cwd=ROOT, **kw)


def buck2_cmd(iso=""):
    """The buck2 binary, with its own daemon and output directory when `iso` is set (parallel matrix cells)."""
    return [BUCK2, "--isolation-dir", iso] if iso else [BUCK2]


def instance(mode, variant, tag=""):
    """Buildbarn instance name = a separate cache namespace. Cold remote runs use a fresh one. With --pool, the name starts
    with `<pool>/`, which is how the Buildbarn frontend routes the actions to that pool's scheduler."""
    name = f"{CFG['name']}-{mode}-{variant}{tag}"
    return f"{POOL}/{name}" if POOL else name


def config_flags(mode, variant, inst, dev=False, salt=""):
    flags = {
        "local": {"remote_cache": "false", "cache_uploads": "false", "remote_execution": "false", "local_execution": "true"},
        "local-cache": {"remote_cache": "true", "cache_uploads": "true", "remote_execution": "false", "local_execution": "true"},
        "remote": {"remote_cache": "false", "cache_uploads": "false", "remote_execution": "true", "local_execution": "false"},
        "remote-cache": {"remote_cache": "true", "cache_uploads": "true", "remote_execution": "true", "local_execution": "false"},
    }[mode]
    args = []
    for k, v in flags.items():
        args += ["--config", f"br2.{k}={v}"]
    args += ["--config", f"br2.native={','.join(CFG['native']) if variant == 'native' else ''}"]
    args += ["--config", f"buck2_re_client.instance_name={inst}"]
    args += ["--config", f"br2.dev_tools={'true' if dev else 'false'}"]     # measured runs are always strict
    if salt:
        args += ["--config", f"br2.cache_salt={salt}"]
    if RE_ENDPOINT:
        for key in ("engine_address", "action_cache_address", "cas_address"):
            args += ["--config", f"buck2_re_client.{key}={RE_ENDPOINT}"]
    return args


def clean(iso=""):
    sh([*buck2_cmd(iso), "kill"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    sh([*buck2_cmd(iso), "clean"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def buck_build(mode, variant, inst, show=False, iso="", salt=""):
    cmd = [*buck2_cmd(iso), "build", TARGET, "--console", "simple", "--keep-going", *config_flags(mode, variant, inst, salt=salt)]
    if show:
        cmd.append("--show-full-output")
    t0 = time.time()
    r = sh(cmd, capture_output=True, text=True)
    dt = time.time() - t0
    out = r.stdout + r.stderr
    m = re.search(r"Commands: (\d+) \(cached: (\d+), remote: (\d+), local: (\d+)\)", out)
    res = {"ok": r.returncode == 0, "seconds": round(dt, 1)}
    if m:
        res.update(commands=int(m[1]), cached=int(m[2]), remote=int(m[3]), local=int(m[4]))
    if r.returncode != 0:
        res["error_tail"] = "\n".join(out.strip().splitlines()[-25:])
    if show and r.returncode == 0:
        line = [l for l in r.stdout.splitlines() if re.match(r"^\S*//:rootfs\s", l)]
        res["output"] = line[0].split(None, 1)[1].strip() if line else None
    return res


def resolve_target(pkg=None, target=None):
    """A Buck2 label: --target as given, --pkg NAME via the model, else the whole rootfs."""
    if target:
        return target
    if pkg:
        model = json.loads((ROOT / "golden" / "model.json").read_text())["packages"]
        if pkg not in model:
            sys.exit(f"{pkg}: not in golden/model.json ({', '.join(sorted(model)[:8])}...)")
        return f"//{model[pkg]['dir']}:{pkg}"
    return TARGET


def failures(out):
    """Every failed action of a --keep-going run, with the last lines of its output."""
    found, seen = [], set()
    blocks = re.split(r"\n(?=\[[0-9T:.+-]+\] Action failed: )", out)
    for b in blocks:
        m = re.match(r"\[[^\]]+\] Action failed: (\S+)", b)
        if not m or m[1] in seen:
            continue
        seen.add(m[1])
        tail = [l for l in b.splitlines() if l.strip() and "[pkg_action]" not in l][-6:]
        found.append((m[1], tail))
    return found


def cmd_dev(a):
    """Iterate without paying for measurement: no `buck2 clean`, daemon and caches kept, every
    independent failure reported in one run, and (unless --strict) the toolkit's own scripts are
    not action inputs, so editing them does not rebuild gcc. Never use these results as numbers."""
    target = resolve_target(a.pkg, a.target)
    cmd = [BUCK2, "build", target, "--console", "simple", "--keep-going",
           *config_flags(a.mode, a.variant, instance(a.mode, a.variant, "-dev"), dev=not a.strict)]
    t0 = time.time()
    r = sh(cmd, capture_output=True, text=True)
    out = r.stdout + r.stderr
    m = re.search(r"Commands: (\d+) \(cached: (\d+), remote: (\d+), local: (\d+)\)", out)
    print(f"{'OK' if r.returncode == 0 else 'FAILED'} {target} in {time.time() - t0:.0f}s"
          + (f"  commands={m[1]} cached={m[2]} remote={m[3]} local={m[4]}" if m else ""))
    for label, tail in failures(out):
        print(f"\n  FAILED {label}")
        for l in tail:
            print("    " + l[:200])
    sys.exit(r.returncode)


def cmd_viewcheck(a):
    """Build every package's `[viewcheck]` sub-target: each package's views are entered with that action's declared inputs
    and nothing is run. With --mode remote* it runs on the worker, where only declared inputs exist, so an entry that
    works locally only because the checkout is on disk fails here in minutes instead of hours into a remote build."""
    q = sh([BUCK2, "uquery", "kind(br2_package, //...)", "--config", "br2.native="], capture_output=True, text=True)
    labels = sorted({l.split(" (")[0].strip() for l in q.stdout.splitlines() if l.startswith("root//")})
    cmd = [BUCK2, "build", *[f"{l}[viewcheck]" for l in labels], "--console", "simple", "--keep-going",
           *config_flags(a.mode, "wrapped", instance(a.mode, "wrapped", "-viewcheck"), dev=False)]
    r = sh(cmd, capture_output=True, text=True)
    out = r.stdout + r.stderr
    m = re.search(r"Commands: (\d+) \(cached: (\d+), remote: (\d+), local: (\d+)\)", out)
    if not labels:
        sys.exit("viewcheck: no br2_package targets found (the uquery failed?); see the output above")
    print(f"{'OK' if r.returncode == 0 else 'FAILED'} {len(labels)} packages" + (f"  commands={m[1]} remote={m[3]} local={m[4]}" if m else ""))
    failed = failures(out)
    for label, tail in failed:
        print(f"\n  FAILED {label}")
        for l in tail:
            print("    " + l[:200])
    if r.returncode != 0 and not failed:             # buck2 failed before any action ran (analysis, daemon, remote routing): say what it said
        print("\n".join("    " + l[:200] for l in out.strip().splitlines()[-25:]))
    sys.exit(r.returncode)


def manifest_diff(image, golden, iso=""):
    tmp = ROOT / "results" / (f".scan-{iso}.json" if iso else ".scan.json")
    tmp.parent.mkdir(exist_ok=True)
    subprocess.run([str(ROOT / "scripts" / "fs-manifest.py"), "scan", image, "-o", str(tmp)], check=True,
                   stdout=subprocess.DEVNULL)
    ignore = [a for path in CFG["manifest_ignore"] for a in ("--ignore", path)]
    r = subprocess.run([str(ROOT / "scripts" / "fs-manifest.py"), "diff", str(golden), str(tmp), *ignore],
                       capture_output=True, text=True)
    return r.stdout.strip().splitlines()


def build_once(mode, variant, cold_state=True, iso=""):
    """Cold and (for the cache modes) warm build of one variant/mode. Returns a result dict.
    `iso` gives the cell its own Buck2 daemon and output directory, so cells can run side by side."""
    # a fresh cache generation for this cell; the warm run of the same cell reuses it
    salt = f"{variant}-{mode}-{time.strftime('%d%H%M%S')}"
    result = {"variant": variant, "mode": mode, "salt": salt}
    golden = ROOT / "golden" / "rootfs.manifest.json"
    if mode == "remote":
        inst = instance(mode, variant, "-" + time.strftime("%H%M%S"))     # nothing cached under it
    else:
        inst = instance(mode, variant)
    if cold_state:
        clean(iso)
    result["instance"] = inst
    result["cold"] = buck_build(mode, variant, inst, show=True, iso=iso, salt=salt)
    if result["cold"]["ok"] and result["cold"].get("output") and golden.exists():
        diff = manifest_diff(result["cold"]["output"], golden, iso)
        result["cold"]["manifest"] = "IDENTICAL" if diff == ["IDENTICAL"] else diff[:20]
    if mode in ("local-cache", "remote-cache") and result["cold"]["ok"]:
        clean(iso)
        result["warm"] = buck_build(mode, variant, inst, show=True, iso=iso, salt=salt)
        if result["warm"]["ok"] and result["warm"].get("output") and golden.exists():
            diff = manifest_diff(result["warm"]["output"], golden, iso)
            result["warm"]["manifest"] = "IDENTICAL" if diff == ["IDENTICAL"] else diff[:20]
    return result


def cmd_setup(a):
    if not a.no_buck2:
        sh([ROOT / "scripts" / "fetch-buck2.sh"], check=True)
    if CFG.get("buildroot"):
        sh([ROOT / "scripts" / "fetch-buildroot.sh"], check=True)


def cmd_fetch(a):
    sh([ROOT / "scripts" / "br2buck.py", "fetch", *(["--vendor-only"] if a.vendor_only else [])], check=True)


def cmd_preflight(a):
    sh([ROOT / "scripts" / "preflight.py", *(["--pkg", *a.pkg] if a.pkg else [])], check=True)


def cmd_extract(_):
    sh([ROOT / "scripts" / "br2buck.py", "extract"], check=True)
    sh([ROOT / "scripts" / "br2buck.py", "render"], check=True)


def golden_job(a):
    """`br2 golden --k8s`: the golden build as a Kubernetes Job on the cluster, in the worker's own tool-baseline
    image (so the golden and the remote builds share one environment). The repository is cloned at the current commit, so push
    first. Small results come back through the pod log (a gzip'd tar between markers); the image and build tree are discarded."""
    import base64
    import io
    import tarfile
    repo = subprocess.check_output(["git", "remote", "get-url", "origin"], cwd=ROOT, text=True).strip()
    repo = re.sub(r"^(https?://)[^/@]+@", r"\1", repo)     # never carry a token from the remote URL into the Job spec or its log
    ref = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip()
    prefix = subprocess.check_output(["git", "rev-parse", "--show-prefix"], cwd=ROOT, text=True).strip().rstrip("/")
    name = re.sub(r"[^a-z0-9-]", "-", f"golden-{CFG['name']}-{ref[:8]}".lower())[:60]
    # downloads from a cluster IP hit rate limits (GitHub 429) now and then: a few tries, a minute apart
    fetch = "for i in 1 2 3 4; do scripts/br2 fetch && break; [ $i = 4 ] && exit 1; sleep 60; done\n" if CFG["sources"] == "vendored" else ""
    vanilla = " --vanilla" if a.vanilla else ""
    results = f"golden/rootfs.{'vanilla.' if a.vanilla else ''}manifest.json results/golden{'-vanilla' if a.vanilla else ''}.json"
    if CFG["sources"] == "vendored":
        results += " golden/sources.lock.json"        # what the Job's fetch pinned: commit it with the manifest
    dl = ("mkdir -p /dl && rm -rf buildroot-src/dl && ln -s /dl buildroot-src/dl\n" if a.dl_claim else "")   # the persistent BR2_DL_DIR
    script = f"""set -eu
git clone --quiet '{repo}' /work/repo
cd /work/repo && git checkout --quiet {ref}
cd /work/repo/{prefix}
/work/repo/toolkit/bin/br2-sync .
scripts/br2 setup --no-buck2
{dl}{fetch}scripts/br2 golden{vanilla}
echo BR2_RESULTS_BEGIN
tar -czf - {results} | base64 -w0
echo
echo BR2_RESULTS_END
"""
    job = {
        "apiVersion": "batch/v1", "kind": "Job",
        "metadata": {"name": name, "namespace": a.namespace, "labels": {"app": "buckroot-golden"}},
        "spec": {
            "backoffLimit": 0, "activeDeadlineSeconds": a.deadline, "ttlSecondsAfterFinished": 3600,
            "template": {
                "metadata": {"labels": {"app": "buckroot-golden"}},
                "spec": {
                    "restartPolicy": "Never",
                    "containers": [{
                        "name": "golden", "image": a.image, "command": ["bash", "-c", script],
                        # JOBS: the golden's make -j; nproc inside a pod is the node's CPU count, not the request
                        "env": [{"name": "HOME", "value": "/work"}, {"name": "BR2_CACHE", "value": "/work/cache"},
                                {"name": "JOBS", "value": str(a.cpu)}],
                        "securityContext": {"privileged": True},      # the fixed-path mount namespace
                        "resources": {"requests": {"cpu": a.cpu, "memory": a.memory}},
                        "volumeMounts": [{"name": "work", "mountPath": "/work"}, {"name": "tmp", "mountPath": "/var/tmp"},
                                         *([{"name": "dl", "mountPath": "/dl"}] if a.dl_claim else [])],
                    }],
                    "volumes": [{"name": "work", "emptyDir": {"sizeLimit": "200Gi"}}, {"name": "tmp", "emptyDir": {"sizeLimit": "100Gi"}},
                                *([{"name": "dl", "persistentVolumeClaim": {"claimName": a.dl_claim}}] if a.dl_claim else [])],
                },
            },
        },
    }
    if a.dry_run:
        print(json.dumps(job, indent=2))
        return
    kubectl = ["kubectl", "-n", a.namespace]
    subprocess.run([*kubectl, "apply", "-f", "-"], input=json.dumps(job), text=True, check=True)
    print(f"job {name}: waiting (a new node can take a few minutes)", flush=True)
    deadline = time.time() + a.deadline + 300
    while time.time() < deadline:
        st = json.loads(subprocess.check_output([*kubectl, "get", "job", name, "-o", "json"], text=True))["status"]
        if st.get("succeeded") or st.get("failed"):
            break
        time.sleep(15)
    else:
        sys.exit(f"job {name} did not finish in time; it is left in place (kubectl -n {a.namespace} logs job/{name})")
    log = subprocess.run([*kubectl, "logs", f"job/{name}"], capture_output=True, text=True)
    m = re.search(r"BR2_RESULTS_BEGIN\n(.*?)\nBR2_RESULTS_END", log.stdout, re.S)
    if not m:
        sys.exit("golden job failed; last log lines:\n" + "\n".join(log.stdout.splitlines()[-30:]) + log.stderr[-500:])
    tarfile.open(fileobj=io.BytesIO(base64.b64decode(m[1])), mode="r:gz").extractall(ROOT)
    print("results written:", results)
    subprocess.run([*kubectl, "delete", "job", name, "--ignore-not-found"], check=False)


def cmd_golden(a):
    if a.k8s:
        return golden_job(a)
    out = CACHE / ("golden-vanilla" if a.vanilla else "golden")
    env = dict(os.environ, OUT=str(out))
    if not a.vanilla:
        env["GOLDEN_FRAGMENT"] = "1"
    t0 = time.time()
    sh([ROOT / "scripts" / "build-rootfs-golden.sh"], check=True, env=env)
    dt = time.time() - t0
    images = out / "images"
    image = images / CFG["rootfs_image"]
    if not image.exists():
        sys.exit(f"no {CFG['rootfs_image']} in {images}: {sorted(p.name for p in images.glob('*'))}")
    name = "rootfs.vanilla.manifest.json" if a.vanilla else "rootfs.manifest.json"
    sh([ROOT / "scripts" / "fs-manifest.py", "scan", image, "-o", ROOT / "golden" / name], check=True)
    res = ROOT / "results"
    res.mkdir(exist_ok=True)
    (res / ("golden-vanilla.json" if a.vanilla else "golden.json")).write_text(
        json.dumps({"seconds": round(dt, 1), "image": str(image)}, indent=1) + "\n")
    print(f"golden build: {dt / 60:.1f} min")


def cmd_build(a):
    print(json.dumps(build_once(a.mode, a.variant), indent=1))


def cmd_matrix(a):
    print("matrix: strict tool inputs, clean state before every cell (numbers are only valid this way)")
    cells = [(variant, mode) for variant in a.variants for mode in a.modes]
    # Cells in parallel each need their own Buck2 daemon and output directory (--isolation-dir); one at a time keeps the default.
    iso = (lambda v, m: f"{v}-{m}") if a.parallel > 1 else (lambda v, m: "")
    if a.dry_run:
        for v, m in cells:
            print(f"cell {v}/{m}: instance {instance(m, v)}, isolation dir '{iso(v, m)}', pool '{POOL or 'default'}', endpoint {RE_ENDPOINT or 'localhost:8980'}")
        return
    results = []
    res_dir = ROOT / "results"
    res_dir.mkdir(exist_ok=True)
    lock = threading.Lock()

    def run(cell):
        v, m = cell
        r = build_once(m, v, iso=iso(v, m))
        with lock:
            results.append(r)
            results.sort(key=lambda x: (cells.index((x["variant"], x["mode"]))))
            (res_dir / "matrix.json").write_text(json.dumps(results, indent=1) + "\n")
            (res_dir / "matrix.md").write_text(render_md(results))
            print(render_md([r]), flush=True)

    with concurrent.futures.ThreadPoolExecutor(max_workers=max(1, a.parallel)) as pool:
        list(pool.map(run, cells))


def render_md(results):
    lines = ["| variant | mode | run | ok | seconds | commands | cached | remote | local | manifest |",
             "|---|---|---|---|---|---|---|---|---|---|"]
    for r in results:
        for run in ("cold", "warm"):
            if run in r:
                x = r[run]
                man = x.get("manifest", "?")
                man = man if isinstance(man, str) else f"{len(man)} diffs"
                lines.append(f"| {r['variant']} | {r['mode']} | {run} | {x['ok']} | {x['seconds']} | "
                             f"{x.get('commands', '')} | {x.get('cached', '')} | {x.get('remote', '')} | "
                             f"{x.get('local', '')} | {man} |")
    return "\n".join(lines) + "\n"


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    su = sub.add_parser("setup")
    su.add_argument("--no-buck2", action="store_true", help="only fetch the source trees (a golden build is plain make and needs no buck2)")
    su.set_defaults(fn=cmd_setup)
    sub.add_parser("extract").set_defaults(fn=cmd_extract)
    fe = sub.add_parser("fetch")
    fe.add_argument("--vendor-only", action="store_true", help="skip make source: vendor from an already filled buildroot-src/dl (e.g. copied from the cluster's golden-dl volume)")
    fe.set_defaults(fn=cmd_fetch)
    d = sub.add_parser("dev", help="iterate: no clean, keep-going, toolkit edits do not invalidate")
    d.add_argument("--pkg", help="build just this package (its target and dependencies)")
    d.add_argument("--target", help="an explicit Buck2 label")
    d.add_argument("--variant", choices=VARIANTS, default="wrapped")
    d.add_argument("--mode", choices=MODES, default="local-cache")
    d.add_argument("--strict", action="store_true", help="keep the toolkit scripts as action inputs")
    d.add_argument("--pool", default="", help="Buildbarn worker pool (instance-name prefix), e.g. dedicated")
    d.set_defaults(fn=cmd_dev)
    vc = sub.add_parser("viewcheck", help="prove every package's view entries are declared inputs (use --mode remote to test on the worker)")
    vc.add_argument("--mode", choices=MODES, default="local")
    vc.add_argument("--pool", default="", help="Buildbarn worker pool (instance-name prefix)")
    vc.set_defaults(fn=cmd_viewcheck)
    pf = sub.add_parser("preflight")
    pf.add_argument("--pkg", nargs="*")
    pf.set_defaults(fn=cmd_preflight)
    g = sub.add_parser("golden")
    g.add_argument("--vanilla", action="store_true")
    g.add_argument("--k8s", action="store_true", help="run as a Kubernetes Job on the cluster, in the worker image (push first; results come back through the pod log)")
    g.add_argument("--namespace", default="buildbarn", help="--k8s: namespace (needs the privileged Pod Security level)")
    g.add_argument("--image", default=os.environ.get("BR2_RUNNER_IMAGE", f"ghcr.io/deepspacecartel/buckroot-worker:{BASELINE or 'latest'}"),
                   help="--k8s: the tool-baseline image (default: the project's baseline, else latest)")
    g.add_argument("--cpu", default="7", help="--k8s: CPU request")
    g.add_argument("--memory", default="28Gi", help="--k8s: memory request")
    g.add_argument("--deadline", type=int, default=14400, help="--k8s: seconds before the Job is stopped")
    g.add_argument("--dl-claim", default="golden-dl", help="--k8s: PersistentVolumeClaim that keeps Buildroot's downloads between Jobs (empty: none)")
    g.add_argument("--dry-run", action="store_true", help="--k8s: print the Job and run nothing")
    g.set_defaults(fn=cmd_golden)
    b = sub.add_parser("build")
    b.add_argument("--variant", choices=VARIANTS, required=True)
    b.add_argument("--mode", choices=MODES, required=True)
    b.add_argument("--pool", default="", help="Buildbarn worker pool (instance-name prefix), e.g. dedicated for measured runs")
    b.set_defaults(fn=cmd_build)
    m = sub.add_parser("matrix")
    m.add_argument("--variants", nargs="+", choices=VARIANTS, default=VARIANTS)
    m.add_argument("--modes", nargs="+", choices=MODES, default=MODES)
    m.add_argument("--pool", default="", help="Buildbarn worker pool (instance-name prefix), e.g. dedicated for measured runs")
    m.add_argument("--parallel", type=int, default=1, help="run this many cells at once, each with its own Buck2 daemon (needs the memory and, for remote modes, enough workers)")
    m.add_argument("--dry-run", action="store_true", help="print the cells and their settings, run nothing")
    m.set_defaults(fn=cmd_matrix)
    a = ap.parse_args()
    global POOL
    POOL = getattr(a, "pool", "") or POOL          # an explicit --pool wins over the project baseline's default
    a.fn(a)


if __name__ == "__main__":
    main()
