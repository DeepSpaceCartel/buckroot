# Secret references (no secrets): `op run` resolves them into the environment of the command that follows.
# Shared by every state: the S3 state backend and the Hetzner Cloud token. platform/ and coder-templates/ add a second file each:
#   op run --env-file=../.env.1password --env-file=../.env.platform.1password -- terraform apply
# Authenticate `op` with `eval $(op signin)` or an OP_SERVICE_ACCOUNT_TOKEN (read access to the vault is enough).

AWS_ACCESS_KEY_ID="op://Deep Space Cartel/AWS Root/AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="op://Deep Space Cartel/AWS Root/AWS_SECRET_ACCESS_KEY"
TF_VAR_hcloud_token="op://Deep Space Cartel/console.hetzner.com/HCLOUD_TOKEN"
