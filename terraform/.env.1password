# Secret references (no secrets): `op run` resolves them into the environment of the command that follows.
#   eval $(op signin)
#   op run --env-file=../.env.1password -- terraform apply        (from cluster/ or platform/)
# Same vault and items as the rts-terraform reference where they exist.

# Terraform state backend (the S3 bucket is set in each terraform.tf)
AWS_ACCESS_KEY_ID="op://Deep Space Cartel/AWS Root/AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="op://Deep Space Cartel/AWS Root/AWS_SECRET_ACCESS_KEY"

# cluster/
TF_VAR_hcloud_token="op://Deep Space Cartel/console.hetzner.com/HCLOUD_TOKEN"

# platform/
TF_VAR_coder_admin_password="op://Deep Space Cartel/Coder Admin/password"
# TODO: create this 1Password item (a generated password) before the first platform apply.
TF_VAR_coder_postgres_password="op://Deep Space Cartel/Buckroot Coder Postgres/password"

# coder-templates/: an API token created in the Coder UI after the platform apply (Account > Tokens).
# TODO: create this 1Password item once Coder is up.
TF_VAR_coder_token="op://Deep Space Cartel/Coder Admin/api_token"
