# Copy to backend.hcl (git-ignored). Any S3-compatible bucket works (AWS S3, Hetzner Object Storage, ...).
bucket       = "your-terraform-state-bucket"
key          = "buckroot/cluster.tfstate"
region       = "us-east-1"
use_lockfile = true
encrypt      = true
# For a non-AWS endpoint:
# endpoints                   = { s3 = "https://hil.your-objectstorage.com" }
# skip_credentials_validation = true
# skip_region_validation      = true
# skip_requesting_account_id  = true
# skip_s3_checksum            = true
